<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>uavx_sim</name>
  <version>0.1.0</version>
  <description>
    The harness every later week writes into. Scenario loading, event
    injection, ROS graph capture, resource sampling and the run record
    writer. It flies vehicles and measures the machine; it carries no swarm
    traffic, so nothing here may touch a tx or rx endpoint.
  </description>
  <maintainer email="megamindsresearch@gmail.com">kartikshirode</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>uavx_msgs</depend>

  <!-- Chunk 3.4. Pure arithmetic only, imported rather than restated: the
       ground station decides what a delivery ratio is and uavx_comms holds
       the frozen protocol constants. The harness carries no swarm traffic
       and still touches no tx or rx endpoint. -->
  <exec_depend>uavx_comms</exec_depend>
  <exec_depend>uavx_gcs</exec_depend>
  <exec_depend>uavx_mission</exec_depend>

  <!-- Chunk 3.6. The camera the recording world carries publishes an image,
       and the runner is the only thing that reads it. -->
  <exec_depend>sensor_msgs</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
