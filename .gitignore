# secrets and credentials
.env
.env.*
*.pem
*.key
id_ed25519*

# python
__pycache__/
*.pyc
.venv/
venv/

# build and sim artifacts
build/
install/
log/
*.log
slurm-*.out
slurm-*.err
out/
.uavx-spec-check-receipt.json
# Loop state, not repository content. .claude/weekly-loop.md names this
# path; a committed one would make the next tick treat a fresh clone as
# a week that died mid-run.
.claude/.weekly-loop-sentinel

# os
Thumbs.db
.DS_Store

# Launcher scratch inside runs/. scripts/sitl_multi.sh writes where it put every
# vehicle and the runner reads it straight back into the record, so the content
# is preserved as evidence in every run record and the file itself is rewritten
# on each launch. The gate's absent-scenario probe is the same shape.
runs/.launcher-spawn.json
runs/.gate-absent-scenario.yaml
