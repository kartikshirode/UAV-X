<?xml version="1.0" ?>
<!--
  The world UAV-X runs in. Chunk 2.4.

  It is PX4's Tools/simulation/gazebo-classic/sitl_gazebo-classic/worlds/
  empty.world at the pinned commit, copied byte for byte, with one plugin block
  added at the end. Every physics figure below is PX4's, unchanged, because a
  different solver or step size is a different simulation and the run records
  would not be comparable with the ones already archived.

  Why the copy exists at all. coverage_fraction is scored from sampled vehicle
  poses read off /gazebo/model_states, and that topic is published by
  libgazebo_ros_state.so, which is a WorldPlugin. A WorldPlugin cannot be
  loaded with gzserver's -s flag; -s takes SystemPlugins, and passing this one
  to it produced exactly one line in the log,

    [Err] [gazebo_shared.cc:46] System is attempting to load a plugin, but
    detected an incorrect plugin type. Plugin filename[libgazebo_ros_state.so]

  and then carried on happily with no ground truth topic at all. The first
  survey run flew for 420 seconds and reported 0 of 400 cells covered, because
  the collector had nothing to collect. A WorldPlugin has to be declared inside
  the world, so the world comes here.

  What this does not fix. /clock is still published at 10 Hz by
  libgazebo_ros_init, which is a SystemPlugin and therefore cannot be declared
  here; its publish_rate is a ROS parameter and gzserver's own argument parser
  is boost::program_options, which rejects the ros-args flag outright. The
  sampler is still capped by that tick. It costs resolution rather than
  coverage: at
  survey speed the along-track spacing is about 0.61 m against a 12 m sensor
  footprint.
-->
<sdf version="1.5">
  <world name="default">
    <!-- A global light source -->
    <include>
      <uri>model://sun</uri>
    </include>
    <!-- A ground plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://asphalt_plane</uri>
    </include>
    <physics name='default_physics' default='0' type='ode'>
      <gravity>0 0 -9.8066</gravity>
      <ode>
        <solver>
          <type>quick</type>
          <iters>10</iters>
          <sor>1.3</sor>
          <use_dynamic_moi_rescaling>0</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
      <magnetic_field>6.0e-6 2.3e-5 -4.2e-5</magnetic_field>
    </physics>

    <!--
      Ground truth, and the only thing this file adds to PX4's.

      The namespace makes the topics /gazebo/model_states and
      /gazebo/link_states, which is what scripts/seam_manifests.json allows the
      link layer and the metrics collector to read and forbids to everything
      else. 50 Hz is above the 20 Hz architecture.md freezes for the coverage
      source and the separation monitor, so the collector decides its own
      sampling rate rather than inheriting one; it drops the frames it does not
      want. Publishing below the sampling target would silently cap it, which is
      the mistake already made once with the pose stream.
    -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
      <update_rate>50.0</update_rate>
    </plugin>
  </world>
</sdf>
