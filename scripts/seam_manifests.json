{
  "_why": "Round 4 finding 4 gave each scenario its own process list. Round 5 finding 7 found that a list of processes is not a graph: a snapshot naming all 13 expected nodes with every endpoint list empty passed clean. Presence was checked and content never was. So each process now also declares the endpoints it MUST hold, and a node that carries none of them fails.",
  "vehicles": [
    "uav_1",
    "uav_2",
    "uav_3",
    "uav_4"
  ],
  "outside_processes": [
    "/link_layer",
    "/metrics_collector",
    "/scenario_runner"
  ],
  "_outside_note": "Matched by exact name. Substring matching gave anything called /uav_2/link_layer_helper the link layer's exemption to read ground truth, which is the whole bypass.",
  "swarm_packet_type": "uavx_msgs/msg/SwarmPacket",
  "ros_infrastructure": {
    "publish": [
      "/rosout",
      "/parameter_events"
    ],
    "subscribe": [
      "/parameter_events",
      "/clock"
    ]
  },
  "scenarios": {
    "relay_required": {
      "week": 3,
      "per_vehicle": [
        "router",
        "mission_executor"
      ],
      "extra": [
        "/gcs/gcs_node"
      ]
    },
    "direct_only": {
      "week": 3,
      "per_vehicle": [
        "router",
        "mission_executor"
      ],
      "extra": [
        "/gcs/gcs_node"
      ]
    },
    "relay_kill": {
      "week": 4,
      "per_vehicle": [
        "router",
        "mission_executor",
        "role_manager"
      ],
      "extra": [
        "/gcs/gcs_node"
      ]
    },
    "mission_integrated": {
      "week": 4,
      "per_vehicle": [
        "router",
        "mission_executor",
        "role_manager"
      ],
      "extra": [
        "/gcs/gcs_node"
      ]
    },
    "link_loss": {
      "week": 4,
      "per_vehicle": [
        "router",
        "mission_executor",
        "role_manager"
      ],
      "extra": [
        "/gcs/gcs_node"
      ]
    }
  },
  "required_outside": [
    "/link_layer",
    "/metrics_collector"
  ],
  "_required_outside_note": "A scenario graph without the link layer in it is not a graph of this system. The radio is the deliverable; if the process modelling it is absent, every delivery number in the run came from somewhere else.",
  "required_endpoints": {
    "router": {
      "publishers": [
        "/uavx/{v}/tx"
      ],
      "subscribers": [
        "/uavx/{v}/rx"
      ]
    },
    "mission_executor": {
      "publishers": [
        "/uavx/{v}/tx",
        "/{v}/fmu/in/*"
      ],
      "subscribers": [
        "/uavx/{v}/rx",
        "/{v}/fmu/out/*"
      ]
    },
    "role_manager": {
      "publishers": [
        "/uavx/{v}/tx"
      ],
      "subscribers": [
        "/uavx/{v}/rx"
      ]
    },
    "gcs_node": {
      "publishers": [
        "/uavx/gcs/tx"
      ],
      "subscribers": [
        "/uavx/gcs/rx"
      ]
    },
    "link_layer": {
      "publishers": [
        "/uavx/uav_1/rx",
        "/uavx/uav_2/rx",
        "/uavx/uav_3/rx",
        "/uavx/uav_4/rx",
        "/uavx/gcs/rx"
      ],
      "subscribers": [
        "/uavx/uav_1/tx",
        "/uavx/uav_2/tx",
        "/uavx/uav_3/tx",
        "/uavx/uav_4/tx",
        "/uavx/gcs/tx",
        "*model_states*"
      ]
    },
    "metrics_collector": {
      "publishers": [],
      "subscribers": [
        "*model_states*"
      ]
    }
  },
  "_required_endpoints_note": "Every entry here must be present or the node fails. {v} is the owning vehicle id. A * glob is allowed only below a namespace whose ownership is already fixed: which PX4 topic the mission executor uses is the implementer's business, whose namespace it is is not.",
  "snapshot_required_meta": [
    "captured_at",
    "scenario",
    "run_id",
    "source_tree_sha256"
  ]
}
